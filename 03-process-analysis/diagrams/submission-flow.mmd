flowchart TD
    A["Открыть курс"] --> B["Прочитать требования"]
    B --> C["Открыть форум в разделе Результаты"]
    C --> D["Добавить тему для обсуждения"]
    D --> E["Заполнить тему и сообщение"]
    E --> F{"Нужно вложение?"}
    F -- "Да" --> G["Расширенная форма: блок Вложение"]
    G -. "Прикрепить допустимые файлы" .-> H["Проверить черновик"]
    F -- "Нет" --> H
    H --> I{"Что делать дальше?"}
    I -- "Исправить" --> E
    I -- "Отменить" --> X["Отмена: вернуться в форум"]
    X --> Z["Вернуться в курс"]
    I -. "Опубликовать" .-> J["Отправить в форум"]
    J -.-> K{"Публикация успешна?"}
    K -. "Нет" .-> L["Исправить данные или повторить"]
    L -.-> E
    K -. "Да" .-> M["Проверить опубликованную тему"]
    M -.-> Z
